[delta]
  minus-style                   = syntax "#430930"
  minus-non-emph-style          = syntax "#430930"
  minus-emph-style              = syntax "#6e0738"
  minus-empty-line-marker-style = syntax "#430930"
  line-numbers-minus-style      = "#E50050"
  plus-style                    = syntax "#132834"
