[delta]
  minus-style                   = syntax "#2d0a2b"
  minus-non-emph-style          = syntax "#2d0a2b"
  minus-emph-style              = syntax "#6e0738"
  minus-empty-line-marker-style = syntax "#2d0a2b"
  line-numbers-minus-style      = "#E50050"
  plus-style                    = syntax "#111f30"
  plus-non-emph-style           = syntax "#111f30"
  plus-emph-style               = syntax "#1a4545"
  plus-empty-line-marker-style  = syntax "#111f30"
  line-numbers-plus-style       = "#2A8A6B"
  line-numbers-zero-style       = "#312e55"
