[delta]
  minus-style                   = syntax "#e4c9be"
  minus-non-emph-style          = syntax "#e4c9be"
  minus-emph-style              = syntax "#d69c9c"
  minus-empty-line-marker-style = syntax "#e4c9be"
  line-numbers-minus-style      = "#BC495D"
  plus-style                    = syntax "#d3d0c0"
  plus-non-emph-style           = syntax "#d3d0c0"
  plus-emph-style               = syntax "#a4afa1"
  plus-empty-line-marker-style  = syntax "#d3d0c0"
  line-numbers-plus-style       = "#4E7469"
  line-numbers-zero-style       = "#ad9b88"
