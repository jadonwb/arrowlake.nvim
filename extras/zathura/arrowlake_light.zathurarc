# Arrowlake color theme for Zathura
# Swaps Foreground for Background to get a light version if the user prefers
#
# Arrowlake color theme
#
set notification-error-bg "#BC495D"
set notification-error-fg "#54473f"
set notification-warning-bg "#AE984C"
set notification-warning-fg "#DED0BF"
set notification-bg "#ebe0cf"
set notification-fg "#54473f"
set completion-bg "#ebe0cf"
set completion-fg "#6c5e55"
set completion-group-bg "#ebe0cf"
set completion-group-fg "#6c5e55"
set completion-highlight-bg "#DED0BF"
set completion-highlight-fg "#54473f"
set index-bg "#ebe0cf"
set index-fg "#54473f"
set index-active-bg "#DED0BF"
set index-active-fg "#54473f"
set inputbar-bg "#ebe0cf"
set inputbar-fg "#54473f"
set statusbar-bg "#ebe0cf"
set statusbar-fg "#54473f"
set highlight-color "#AE984C"
set highlight-active-color "#4E7469"
set default-bg "#ebe0cf"
set default-fg "#54473f"
set render-loading true
set render-loading-fg "#ebe0cf"
set render-loading-bg "#54473f"
#
# Recolor mode settings
# <C-r> to switch modes
#
set recolor-lightcolor "#ebe0cf"
set recolor-darkcolor "#54473f"
