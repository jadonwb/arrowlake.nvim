# Import this theme as follows:
# 1. Create a new profile for GNOME Terminal
# 2. Copy the UUID of the new profile (bottom right corner of the preferences window)
# 3. Replace <PROFILE_UUID> below with the copied UUID
# 4. Execute `dconf load /org/gnome/terminal/legacy/profiles:/ < arrowlake_light.dconf`

[:<PROFILE_UUID>]
background-color='rgb(235, 224, 207)'
cursor-background-color='rgb(84, 71, 63)'
cursor-colors-set=true
cursor-foreground-color='rgb(235, 224, 207)'
foreground-color='rgb(84, 71, 63)'
highlight-background-color='rgb(84, 71, 63)'
highlight-colors-set=true
highlight-foreground-color='rgb(235, 224, 207)'
palette=['#DED0BF', 'rgb(188, 73, 93)', 'rgb(78, 116, 105)', 'rgb(174, 152, 76)', 'rgb(74, 116, 168)', 'rgb(193, 108, 144)', 'rgb(86, 174, 169)', 'rgb(84, 71, 63)', '#DED0BF', 'rgb(188, 73, 93)', 'rgb(78, 116, 105)', 'rgb(174, 152, 76)', 'rgb(74, 116, 168)', 'rgb(193, 108, 144)', 'rgb(86, 174, 169)', 'rgb(84, 71, 63)']
use-theme-colors=false
visible-name='Arrowlake Light'
