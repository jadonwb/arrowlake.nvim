        "900": "#366299"
      },
      "purple": {
        "100": "#f4f4fe",
        "200": "#ddddfe",
        "300": "#c6c6fe",
        "400": "#b2b1ee",
        "500": "#9e9cde",
        "600": "#8b88ce",
        "700": "#7874bf",
        "800": "#6660af",
        "900": "#554c9f"
      },
      "accent": "$hue.cyan",
      "interactive": "$hue.purple",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "blue",
      "cyan",
      "green",
      "yellow",
      "purple",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "$hue.neutral.200",
          "$selected": "$hue.interactive.800"
        },
        "secondary": {
          "default": "$text.subdued",
          "$hovered": "$text.default"
        },
        "destructive": {
          "default": "$hue.neutral.200",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "$hue.red.800"
        },
        "warning": {
          "default": "$hue.yellow.800"
        },
        "success": {
          "default": "$hue.green.800"
        },
        "info": {
          "default": "$hue.blue.800"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "raised": {
        "base": "#ded0bf",
        "high": "#6660af",
        "max": "#ded0bf"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
