        "secondary": {
          "default": "transparent"
        },
        "destructive": {
          "default": "$hue.red.800"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "$hue.interactive.800"
    },
    "scrollbar": {
      "default": "$hue.accent.800"
    },
    "diff": {
      "text": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800",
        "context": "#6c5e55",
        "hunkHeader": "#87786c"
      },
      "background": {
        "added": "#d3d0c0",
        "removed": "#e4c9be",
        "context": "#e3d7c7"
      },
      "highlight": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800"
      },
      "lineNumber": {
        "text": "#ad9b88",
        "background": {
          "added": "#d3d0c0",
          "removed": "#e4c9be"
        }
      }
    },
    "syntax": {
      "comment": "#87786c",
      "keyword": "#c16c90",
      "function": "$hue.interactive.800",
      "variable": "$hue.neutral.800",
      "string": "$hue.green.800",
      "number": "$hue.yellow.800",
      "type": "$hue.blue.800",
      "operator": "#6a8b89",
      "punctuation": "#6c5e55"
    },
    "markdown": {
      "text": "$hue.neutral.800",
      "heading": "$hue.interactive.800",
      "link": "#cf9978",
      "linkText": "#cf9978",
      "code": "$hue.green.800",
      "blockQuote": "#87786c",
      "emphasis": "$hue.neutral.800",
      "strong": "$hue.neutral.800",
      "horizontalRule": "$hue.neutral.600",
      "listItem": "#cf9978",
      "listEnumeration": "#cf9978",
      "image": "#cf9978",
      "imageText": "#cf9978",
      "codeBlock": "$hue.neutral.800"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.raised.base",
        "raised": {
          "base": "#ded0bf",
          "high": "#6660af",
          "max": "#ded0bf"
        },
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.raised.high",
        "raised": {
          "base": "#ded0bf",
          "high": "#6660af",
          "max": "#ded0bf"
        }
      }
    }
  },
