{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": ["?.lua", "?/init.lua"],
    "pathStrict": true
  },
  "workspace": {
    "checkThirdParty": false,
    "ignoreDir": ["/extras"]
  },
  "diagnostics": {
    "globals": ["vim", "before_each", "describe", "it"],
    "disable": ["lowercase-global"]
  },
  "hint": {
    "enable": true
  }
}
